# Auto-generated by scripts/setup.py — edit only if you want to override

# Database (PostgreSQL preferred, SQLite fallback)
DATABASE_URL=postgresql://bnb:bnb@localhost:5432/bitnbulid

# Data source — leave SPACETRACK_USER blank to use Celestrak instead
SPACETRACK_USER=
SPACETRACK_PASS=

# If both Space-Track fields are blank, this is set to true automatically
USE_CELESTRAK=true

# Screening parameters
SCREENING_DISTANCE_KM=5.0
SCREENING_HORIZON_HOURS=24.0
PC_ALERT_THRESHOLD=1e-4
